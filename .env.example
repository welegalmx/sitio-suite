# --- Registro ASOFOM (formulario /asofom → Google Sheets) ---
# Service account de Google (proyecto we-legal-documentos).
# El client_email del JSON de la service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL="we-legal-docs-service@we-legal-documentos.iam.gserviceaccount.com"

# La private_key del JSON. En local puede ir entre comillas con \n literales.
# En Vercel, pega el valor tal cual (con los saltos de línea) en la UI.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID de la hoja de cálculo destino (el tramo entre /d/ y /edit en la URL).
ASOFOM_SHEET_ID=""

# (Opcional) Nombre de la pestaña destino. Default: "Registros".
ASOFOM_SHEET_TAB="Registros"
